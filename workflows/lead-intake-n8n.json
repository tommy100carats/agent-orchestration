{
  "name": "Daily Lead Intake → Notion (generic template)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * 1-5" }
          ]
        }
      },
      "id": "trigger",
      "name": "Chaque matin 8h (lun-ven)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 400]
    },
    {
      "parameters": {
        "jsCommand": "// Rotation de villes : 1 ville par jour ouvré pour varier les zones et limiter les doublons.\nconst villes = [\n  'Paris', 'Lyon', 'Marseille', 'Lille', 'Bordeaux',\n  'Toulouse', 'Nantes', 'Strasbourg', 'Rennes', 'Rouen',\n  'Nice', 'Montpellier', 'Amiens', 'Reims', 'Le Havre'\n];\n// index basé sur le jour de l'année pour tourner\nconst jour = Math.floor((Date.now() - Date.UTC(new Date().getUTCFullYear(),0,0)) / 86400000);\nconst ville = villes[jour % villes.length];\nreturn [{ json: { ville, query: `entreprise de dératisation ${ville}` } }];"
      },
      "id": "pickCity",
      "name": "Choisir la ville du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Goog-Api-Key", "value": "={{ $env.GOOGLE_PLACES_API_KEY }}" },
            { "name": "X-Goog-FieldMask", "value": "places.displayName,places.nationalPhoneNumber,places.websiteUri,places.formattedAddress" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"textQuery\": \"{{ $json.query }}\",\n  \"languageCode\": \"fr\",\n  \"regionCode\": \"FR\",\n  \"maxResultCount\": 20\n}",
        "options": {}
      },
      "id": "googlePlaces",
      "name": "Google Places — recherche",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 400],
      "notesInFlow": true,
      "notes": "Nécessite une clé Google Places API (New) dans la variable d'env GOOGLE_PLACES_API_KEY"
    },
    {
      "parameters": {
        "jsCommand": "// Aplatit la réponse Google Places, garde 10 entreprises exploitables.\nconst ville = $('Choisir la ville du jour').first().json.ville;\nconst places = $input.first().json.places || [];\nconst out = [];\nfor (const p of places) {\n  const nom = p.displayName?.text?.trim();\n  if (!nom) continue;\n  out.push({\n    json: {\n      Entreprise: nom,\n      Telephone: p.nationalPhoneNumber || '',\n      SiteWeb: p.websiteUri || '',\n      Ville: p.formattedAddress || ville,\n      Source: 'Google Places API',\n      Niche: 'Dératisation',\n      Statut: 'À contacter',\n      PointDeTension: p.websiteUri ? 'À qualifier (vérifier prise de RDV en ligne / relance devis)' : 'Pas de site web → faible maturité num., cible chaude'\n    }\n  });\n  if (out.length >= 10) break;\n}\nreturn out;"
      },
      "id": "mapLeads",
      "name": "Formater 10 leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 400]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": "YOUR_NOTION_DATABASE_ID",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "anyFilter",
        "filters": {
          "conditions": [
            {
              "key": "Entreprise|title",
              "condition": "equals",
              "titleValue": "={{ $json.Entreprise }}"
            }
          ]
        },
        "options": {}
      },
      "id": "dedupe",
      "name": "Déjà dans le CRM ?",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1180, 400],
      "credentials": {
        "notionApi": { "id": "YOUR_NOTION_CREDENTIAL_ID", "name": "Notion API" }
      },
      "notes": "Vérifie l'existence par nom d'entreprise pour éviter les doublons"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.Entreprise }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ifNew",
      "name": "Nouveau uniquement",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [1180, 620],
      "notes": "Ne garde que les leads absents du CRM (résultat getAll vide)"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": "YOUR_NOTION_DATABASE_ID",
        "title": "={{ $json.Entreprise }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Statut|select", "selectValue": "À contacter" },
            { "key": "Niche|select", "selectValue": "Dératisation" },
            { "key": "Téléphone|phone_number", "phoneValue": "={{ $json.Telephone }}" },
            { "key": "Site web|url", "urlValue": "={{ $json.SiteWeb }}" },
            { "key": "Ville|rich_text", "textContent": "={{ $json.Ville }}" },
            { "key": "Point de tension|rich_text", "textContent": "={{ $json.PointDeTension }}" },
            { "key": "Source|rich_text", "textContent": "={{ $json.Source }}" }
          ]
        },
        "options": {}
      },
      "id": "createLead",
      "name": "Créer le lead dans Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1420, 620],
      "credentials": {
        "notionApi": { "id": "YOUR_NOTION_CREDENTIAL_ID", "name": "Notion API" }
      }
    }
  ],
  "connections": {
    "Chaque matin 8h (lun-ven)": { "main": [[{ "node": "Choisir la ville du jour", "type": "main", "index": 0 }]] },
    "Choisir la ville du jour": { "main": [[{ "node": "Google Places — recherche", "type": "main", "index": 0 }]] },
    "Google Places — recherche": { "main": [[{ "node": "Formater 10 leads", "type": "main", "index": 0 }]] },
    "Formater 10 leads": { "main": [[{ "node": "Déjà dans le CRM ?", "type": "main", "index": 0 }]] },
    "Déjà dans le CRM ?": { "main": [[{ "node": "Nouveau uniquement", "type": "main", "index": 0 }]] },
    "Nouveau uniquement": { "main": [[{ "node": "Créer le lead dans Notion", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "description": "Generic daily lead-intake template. Pulls local businesses from Google Places, dedupes against a Notion CRM, and writes new leads. Rotate city daily to spread coverage. Replace placeholders before use." }
}
